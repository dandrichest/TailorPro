@page "/dashboard"
@inject TailorPro.Services.DashboardService DashboardService
@inject IJSRuntime JS

<h2 class="mb-4 fw-bold">📊 Dashboard Overview</h2>

<div class="row g-4">

    <!-- Total Orders -->
    <div class="col-md-3">
        <div class="card shadow-lg stat-card border-0 text-white bg-primary">
            <div class="card-body">
                <h6>Total Orders</h6>
                <h2>@totalOrders</h2>
            </div>
        </div>
    </div>

    <!-- Pending Orders -->
    <div class="col-md-3">
        <div class="card shadow-lg stat-card border-0 text-white bg-warning">
            <div class="card-body">
                <h6>Pending</h6>
                <h2>@pendingOrders</h2>
            </div>
        </div>
    </div>

    <!-- Completed Orders -->
    <div class="col-md-3">
        <div class="card shadow-lg stat-card border-0 text-white bg-success">
            <div class="card-body">
                <h6>Completed</h6>
                <h2>@completedOrders</h2>
            </div>
        </div>
    </div>

    <!-- Delivered Orders -->
    <div class="col-md-3">
        <div class="card shadow-lg stat-card border-0 text-white bg-dark">
            <div class="card-body">
                <h6>Delivered</h6>
                <h2>@deliveredOrders</h2>
            </div>
        </div>
    </div>

</div>

<div class="row mt-4">

    <!-- Revenue -->
    <div class="col-md-6">
        <div class="card shadow-lg revenue-card border-0 text-white bg-info">
            <div class="card-body">
                <h5>Total Revenue</h5>
                <h2>₦ @totalRevenue.ToString("N2")</h2>
            </div>
        </div>
    </div>

    <!-- Extra Section -->
    <div class="col-md-6">
        <div class="card shadow-lg border-0">
            <div class="card-body">
                <h5>Business Summary</h5>
                <p>Total Orders: @totalOrders</p>
                <p>Pending: @pendingOrders</p>
                <p>Completed: @completedOrders</p>
                <p>Delivered: @deliveredOrders</p>
            </div>
        </div>
    </div>

</div>

<div class="row mt-5">
    <div class="col-md-6">
        <div class="card shadow-lg p-3">
            <h5>Order Status Distribution</h5>
            <canvas id="orderChart"></canvas>
        </div>
    </div>
</div>


<style>
    .stat-card {
        transition: all 0.3s ease;
        border-radius: 15px;
    }

    .stat-card:hover {
        transform: translateY(-5px) scale(1.03);
    }

    .revenue-card {
        border-radius: 15px;
    }

    h2 {
        font-weight: bold;
    }
</style>

@code {
    private int totalOrders;
    private int pendingOrders;
    private int completedOrders;
    private int deliveredOrders;
    private decimal totalRevenue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender)
    {
        totalOrders = DashboardService.GetTotalOrders();
        pendingOrders = DashboardService.GetPendingOrders();
        completedOrders = DashboardService.GetCompletedOrders();
        deliveredOrders = DashboardService.GetDeliveredOrders();
        totalRevenue = DashboardService.GetTotalRevenue();

        await JS.InvokeVoidAsync("renderOrderChart",
            pendingOrders,
            completedOrders,
            deliveredOrders);
    }
}
}