@page "/services"
@rendermode InteractiveServer
@using TailorPro.Data

<PageTitle>Services</PageTitle>

<div class="services-page">
    <header class="services-header">
        <h1>Our Services</h1>
        <input type="text"
               class="search-input"
               placeholder="Search services..."
               @bind="searchTerm"
               @bind:event="oninput" />
    </header>

    <div class="services-grid">
        @foreach (var service in FilteredServices)
        {
            <ServiceCard ServiceItem="service" AddToCart="AddToCart" />
        }
    </div>

    @if (!string.IsNullOrEmpty(cartMessage))
    {
        <div class="toast @(toastVisible ? "toast-show" : "toast-hide")">
            @cartMessage
        </div>
    }
</div>

<style>
    .services-page { padding: 24px; max-width: 1200px; margin: 0 auto; }
    .services-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; gap: 16px; flex-wrap: wrap; }
    .search-input { padding: 10px 14px; border: 1px solid #ddd; border-radius: 10px; min-width: 240px; }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .service-card { cursor: pointer; transition: transform .15s ease, box-shadow .15s ease; }
    .service-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(0,0,0,.12); }

    .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 1000; }
    .modal-panel {
        position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: min(520px, 92vw); max-height: 90vh; overflow: auto;
        background: #fff; border-radius: 16px; z-index: 1001;
        box-shadow: 0 24px 60px rgba(0,0,0,.25);
    }
    .modal-close { position: absolute; top: 10px; right: 14px; background: none; border: 0; font-size: 26px; cursor: pointer; line-height: 1; }
    .modal-photo { width: 100%; height: 260px; object-fit: cover; border-radius: 16px 16px 0 0; display: block; }
    .modal-body { padding: 20px 22px 24px; }
    .modal-body h2 { margin: 8px 0 12px; }

    .toast {
        position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
        background: #111; color: #fff; padding: 12px 20px; border-radius: 10px;
        transition: opacity .3s ease; z-index: 2000;
    }
    .toast-show { opacity: 1; }
    .toast-hide { opacity: 0; }
</style>

@code {
    private string? cartMessage;
    private string searchTerm = string.Empty;
    private bool toastVisible = false;
    private System.Threading.CancellationTokenSource? toastCts;

    private IEnumerable<ServiceItem> FilteredServices =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? ServicesData.All
            : ServicesData.All.Where(s =>
                s.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                s.Category.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private async Task AddToCart(ServiceItem service)
    {
        toastCts?.Cancel();
        toastCts = new System.Threading.CancellationTokenSource();
        var token = toastCts.Token;

        cartMessage = $"{service.Name} added to cart";
        toastVisible = true;
        StateHasChanged();

        try
        {
            await Task.Delay(2500, token);
            toastVisible = false;
            StateHasChanged();
            await Task.Delay(300, token);
            cartMessage = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }
}
