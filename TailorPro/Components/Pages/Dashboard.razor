@page "/dashboard"
@using Microsoft.EntityFrameworkCore
@using TailorPro.Data
@using TailorPro.Models
@using Microsoft.AspNetCore.Authorization
@inject ApplicationDbContext Db
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Dashboard — TailorPro</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-speedometer2 me-2"></i>Tailoring Dashboard</h2>
            <p class="text-muted small mb-0">Overview of active metrics, pending requests, and order summary.</p>
        </div>
    </div>

    @if (!loaded)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Metrics -->
        <div class="row g-4 mb-5">
            <!-- Total Customers -->
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-4 text-center">
                        <div class="p-3 mx-auto mb-3 bg-light rounded-circle text-success d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-people-fill fs-3"></i>
                        </div>
                        <h6 class="text-muted text-uppercase small fw-bold">Total Customers</h6>
                        <h2 class="fw-bold text-dark mb-0 mt-2">@totalCustomers</h2>
                    </div>
                </div>
            </div>

            <!-- Pending Orders -->
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-4 text-center">
                        <div class="p-3 mx-auto mb-3 bg-light rounded-circle text-warning d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-clock-history fs-3"></i>
                        </div>
                        <h6 class="text-muted text-uppercase small fw-bold">Pending Orders</h6>
                        <h2 class="fw-bold text-dark mb-0 mt-2">@pendingOrders</h2>
                    </div>
                </div>
            </div>

            <!-- In Progress -->
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-4 text-center">
                        <div class="p-3 mx-auto mb-3 bg-light rounded-circle text-info d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-gear-wide-connected fs-3"></i>
                        </div>
                        <h6 class="text-muted text-uppercase small fw-bold">In Progress</h6>
                        <h2 class="fw-bold text-dark mb-0 mt-2">@inProgressOrders</h2>
                    </div>
                </div>
            </div>

            <!-- Completed -->
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-4 text-center">
                        <div class="p-3 mx-auto mb-3 bg-light rounded-circle text-success d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-check-circle-fill fs-3"></i>
                        </div>
                        <h6 class="text-muted text-uppercase small fw-bold">Completed Orders</h6>
                        <h2 class="fw-bold text-dark mb-0 mt-2">@completedOrders</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity Section -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
            <div class="card-header bg-light py-3 border-0">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-list-stars me-2"></i>Recent Tailoring Orders</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light small fw-bold text-muted text-uppercase">
                        <tr>
                            <th class="ps-4">Customer</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Order Date</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (!recentOrders.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    No orders created yet. <a href="/orders/add">Click here</a> to create the first order.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var o in recentOrders)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">
                                        <a href="/customers/@o.CustomerId" class="text-decoration-none text-dark">@o.Customer.FullName</a>
                                    </td>
                                    <td class="text-secondary">@o.Description</td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-1.5 fw-semibold @BadgeClass(o.Status)">
                                            @o.Status
                                        </span>
                                    </td>
                                    <td class="text-muted">@o.OrderDate.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool loaded = false;
    private int totalCustomers, pendingOrders, inProgressOrders, completedOrders;
    private List<Order> recentOrders = new();

    protected override async Task OnInitializedAsync()
    {
        totalCustomers   = await Db.Customers.CountAsync();
        pendingOrders    = await Db.Orders.CountAsync(o => o.Status == OrderStatus.Pending);
        inProgressOrders = await Db.Orders.CountAsync(o => o.Status == OrderStatus.InProgress);
        completedOrders  = await Db.Orders.CountAsync(o => o.Status == OrderStatus.Completed);
        recentOrders     = await Db.Orders
                                   .Include(o => o.Customer)
                                   .OrderByDescending(o => o.OrderDate)
                                   .Take(5)
                                   .ToListAsync();
        loaded = true;
    }

    private string BadgeClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending    => "bg-warning text-dark border border-warning",
        OrderStatus.InProgress => "bg-info text-dark border border-info",
        OrderStatus.Completed  => "bg-success text-white border border-success",
        OrderStatus.Delivered  => "bg-secondary text-white border border-secondary",
        _                      => "bg-light text-dark border"
    };
}